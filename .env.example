# Copy this file to .env and replace the placeholder values.
# Environment variables override values in .env.

WEBSERVER__URL_BASE_PATH=/
WEBSERVER__DEBUG_LEVEL=DEBUG
WEBSERVER__PORT=8080
WEBSERVER__ENV=dev
WEBSERVER__USE_SSL=on
WEBSERVER__CERT_FILE=</path/to/fullchain.pem>
WEBSERVER__KEY_FILE=</path/to/privkey.pem>
WEBSERVER__SSL_HOSTNAME=<hostname>
WEBSERVER__CLIENT_SECRET=<your-default-client-secret-here>
WEBSERVER__SITE_SECRETS='{"site1":"<site1-client-secret>","site2":"<site2-client-secret>","site3":"<site3-client-secret>"}'

SDS_SYNC__HSI_BIN_PATH=/usr/local/bin
SDS_SYNC__HSI_KEYTAB_PATH=</path/to/xxx.keytab>
SDS_SYNC__HSI_USER=<hsi username>
SDS_SYNC__FIREWALL_FLAG=on
SDS_SYNC__TIMEOUT_IN_SECS=3300

SDS_ASYNC__MESSAGE_BROKER_HOST=localhost
SDS_ASYNC__MESSAGE_BROKER_PORT=5672
SDS_ASYNC__WORK_QUEUE=isdp_task_queue
SDS_ASYNC__SAME_JOB_MINIMUM_INTERVAL_IN_MIN=360
SDS_ASYNC__BLACK_LIST=</path/to/black_list.txt>

WORKER__STAGING_DIR=staging
WORKER__SMTP_SERVER=localhost
WORKER__EMAIL_SENDER=<email_sender>
WORKER__CONTACT_EMAIL=<contact_email>
WORKER__HTTP_DOWNLOAD_SERVER=https://<hostname>/staging
WORKER__STAGING_USAGE_THRESHOLD_IN_GB=1

DATABASE__HOST=localhost
DATABASE__USER=dbtester
DATABASE__PASSWORD=<database-password>
DATABASE__DB=my_app_db
DATABASE__JOB_TABLE=user_jobs

LOGGING__API_LOG_FILE=api.log
LOGGING__WORKER_LOG_FILE=worker.log
